/* Based on the PS2SDK EE linker script (AFL-2.0). */
ENTRY(__start);

MEMORY {
    lowram (rwx) : ORIGIN = 0x00084000, LENGTH = 496K
}

PHDRS {
    text PT_LOAD;
}

SECTIONS {
    .text : {
        *(.text .text.*)
        KEEP(*(.init))
        KEEP(*(.fini))
    } >lowram :text
    .ctors : { KEEP(*(.ctors .ctors.*)) } >lowram
    .dtors : { KEEP(*(.dtors .dtors.*)) } >lowram
    .reginfo : { *(.reginfo) } >lowram
    .rodata ALIGN(128) : { *(.rodata .rodata.* .rdata .rdata.*) } >lowram
    .data ALIGN(128) : { *(.data .data.*) } >lowram
    _gp = ALIGN(128) + 0x7ff0;
    .sdata : { *(.sdata .sdata.* .lit4 .lit8) } >lowram
    .bss ALIGN(128) : {
        _fbss = .;
        *(.sbss .sbss.* .scommon .bss .bss.* COMMON)
        . = ALIGN(128);
        _end_bss = .;
    } >lowram
    _end = .;
    PROVIDE(end = .);
    PROVIDE(_heap_size = 0);
    PROVIDE(_stack = 0x000f0000);
    PROVIDE(_stack_size = 64K);
    ASSERT(_end <= _stack, "POPStarter loader overlaps its stack")
}
